    {
      "id": "character-broadcast",
      "class": "zombie/iso/IsoObject.class",
      "symbol": "transmitModData()",
      "observation": "Sends ObjectModData; GameServer.sendObjectModData routes to nearby clients. Packet writes the entire table."
    },
    {
      "id": "character-client-replacement",
      "class": "zombie/network/packets/ObjectModDataPacket.class",
      "symbol": "parse(ByteBufferReader, IConnection)",
      "observation": "Loads supplied table into the resolved object; MovingObject supports players and its consistency check only tests resolution in inspected bytes."
    },
    {
      "id": "global-table-disclosure",
      "class": "zombie/world/moddata/GlobalModData.class",
      "symbol": "receiveRequest(ByteBufferReader, IConnection)",
      "observation": "Returns a named table to the requesting connection without mod visibility filtering. No private-storage guarantee."
    },
    {
      "id": "item-synchronization",
      "class": "zombie/Lua/LuaManager$GlobalObject.class",
      "symbol": "syncItemModData(IsoPlayer, InventoryItem)",
      "observation": "Server-only relative-client full item ModData route; not a private partial-payload transport. InventoryItem defines no transmitModData method."
    },
    {
      "id": "player-field-mask",
      "class": "zombie/network/packets/SyncPlayerFieldsPacket.class",
      "symbol": "writeParam(byte, ByteBufferWriter)",
      "observation": "Recipes, traits, already-read books, body damage, reading and fitness only; no arbitrary ModData or generic media-mask permission."
    },
    {
      "id": "xp-not-raw",
      "class": "zombie/characters/IsoGameCharacter$XP.class",
      "symbol": "AddXP(Perk, float, boolean, boolean, boolean, boolean)",
      "observation": "Sleep/Fitness can refuse; Strength protein adjustments precede the boost branch. No safe exact-perk setter established; public xpMap field is not an approved write/reconciliation API."
    },
    {
      "id": "xp-silent-refusal",
      "class": "zombie/Lua/LuaManager$GlobalObject.class",
      "symbol": "addXp(IsoPlayer, Perk, float)",
      "observation": "Void call may return before mutation; server branch also has connection/capability/death checks. Successful Lua invocation alone is not an applied award."
    },
    {
      "id": "recipe-earned-state",
      "class": "zombie/characters/IsoGameCharacter.class",
      "symbol": "getKnownRecipes(); isRecipeKnown(); learnRecipe()",
      "observation": "Explicit known list differs from visibility/debug/craftability; learnRecipe checks known state before optional meta expansion."
    },
    {
      "id": "recipe-derived-state",
      "class": "zombie/scripting/ScriptManager.class",
      "symbol": "checkAutoLearn(); checkMetaRecipe()",
      "observation": "Auto-learning and meta recipes evaluate derived requirements and are not an explicit journal-earned snapshot."
    },
    {
      "id": "media-persistence",
      "class": "zombie/characters/IsoGameCharacter.class",
      "symbol": "isKnownMediaLine(); saveKnownMediaLines(); loadKnownMediaLines()",
      "observation": "Stable trimmed GUID membership has character save/load paths; reward application and peer synchronization remain separate contracts."
    },
    {
      "id": "timed-action-callbacks",
      "class": "zombie/core/NetTimedAction.class",
      "symbol": "start(); stop(); perform(); update()",
      "observation": "Inspected start/stop call serverStart/serverStop; perform invokes complete. This update body is empty; client update is not verified incremental server work."
    },
    {
      "id": "timed-action-clock",
      "class": "zombie/core/Action.class",
      "symbol": "setTimeData()",
      "observation": "Uses server milliseconds; NetTimedAction adjusts duration and multiplies by 20. Raw action duration is not proof of elapsed game minutes."
    },
    {
      "id": "private-file-candidate",
      "class": "zombie/Lua/LuaManager$GlobalObject.class",
      "symbol": "getFileWriter(String, boolean, boolean)",
      "observation": "Lua-cache-rooted writer supports append and can return null. Atomic replacement, durable flush and cross-world transaction safety are not established by this route."
    }
